#!/bin/sh
# Kormcrete Order Desk Compose on your own Java (17 or newer), with the JVM options of the packaged app. Uses
# $JAVA_HOME/bin/java when JAVA_HOME is set, else the java on your PATH. Options a Java does not know are ignored.
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -n "${JAVA_HOME:-}" ]; then JAVA="$JAVA_HOME/bin/java"; else JAVA=java; fi
if ! command -v "$JAVA" > /dev/null 2>&1; then
  echo "Kormcrete Order Desk Compose needs Java 17 or newer: install it, or set JAVA_HOME." >&2
  exit 1
fi
set --
[ "$(uname -s)" = Darwin ] && set -- "-Xdock:name=Kormcrete Order Desk Compose"
exec "$JAVA" -XX:+IgnoreUnrecognizedVMOptions --enable-native-access=ALL-UNNAMED "$@" \
  -Dcompose.application.configure.swing.globals=true \
  -XX:+UseSerialGC -Xms24m -Xmx384m -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=30 -XX:+UseCompactObjectHeaders \
  -XX:+UseStringDeduplication -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=48m -Xss512k -XX:-UsePerfData \
  -cp "$DIR/lib/*" io.github.kormcrete.orderdesk.desktop.MainKt
